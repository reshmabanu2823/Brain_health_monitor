# All settings are optional; defaults shown.
BHM_HOST=127.0.0.1
BHM_PORT=8000
BHM_MODEL_DIR=model
BHM_UPLOAD_DIR=uploads
BHM_LOG_DIR=logs
BHM_MAX_UPLOAD_BYTES=10485760
BHM_MAX_CONCURRENT_ANALYSES=2
# Comma-separated origins; empty disables CORS
BHM_CORS_ORIGINS=

# EEG: explicit source selection in /eeg; no automatic demo/hardware fallback
BHM_EEG_SAMPLE_RATE=250
BHM_EEG_WINDOW_SECONDS=4
BHM_EEG_GUARD_SECONDS=1
BHM_EEG_LOW_HZ=1
BHM_EEG_HIGH_HZ=40
# Use off to disable; otherwise 50 or 60, strictly below Nyquist
BHM_EEG_NOTCH_HZ=50
BHM_EEG_DB=logs/eeg.db
BHM_EEG_MODEL_DIR=eeg_model
